<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.nom }}</title>
  <meta name="description" content="{{ description | default(site.baseline + ' — ' + site.ouverture + '. ' + site.adresse + '. ' + site.tel) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
</head>
<body>
  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="brand" href="/">
        <img src="/assets/img/favicon.svg" alt="" class="brand-logo">
        <span class="brand-name">{{ site.nom }}</span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="main-nav" id="main-nav" aria-label="Navigation principale">
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.url }}" class="{% if item.cta %}btn btn-small{% endif %} {% if page.url == item.url %}active{% endif %}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <p class="footer-brand">{{ site.nom }}</p>
        <p class="footer-baseline">{{ site.baseline }}</p>
        <p>Accueil par {{ site.hote }}</p>
      </div>
      <div>
        <p class="footer-title">Contact</p>
        <p>{{ site.adresseLignes | join("<br>") | safe }}</p>
        <p><a href="tel:{{ site.telHref }}">{{ site.tel }}</a><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <div>
        <p class="footer-title">Infos pratiques</p>
        <p>{{ site.ouverture }}</p>
        <p><a href="/chambres/">Chambres</a><br>
           <a href="/contact/">Réserver</a></p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© <span id="year"></span> {{ site.nom }} — Orgnac-l'Aven, Ardèche · <a href="/credits/">Crédits photos</a></p>
    </div>
  </footer>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visionneuse photo">
    <span class="lightbox-caption" id="lightbox-caption"></span>
    <button class="lightbox-btn lightbox-close" id="lightbox-close" aria-label="Fermer">×</button>
    <button class="lightbox-btn lightbox-prev" id="lightbox-prev" aria-label="Photo précédente">‹</button>
    <img id="lightbox-img" src="" alt="">
    <button class="lightbox-btn lightbox-next" id="lightbox-next" aria-label="Photo suivante">›</button>
    <span class="lightbox-counter" id="lightbox-counter"></span>
  </div>

  <script src="/assets/js/main.js"></script>
</body>
</html>
