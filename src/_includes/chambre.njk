---
layout: base.njk
---
<article class="room-page container">
  <p class="breadcrumb"><a href="/chambres/">← Toutes les chambres</a></p>
  <div class="room-hero">
    <img src="{{ image }}" alt="Chambre {{ title }}" class="room-hero-img" loading="lazy" decoding="async">
    <div class="room-hero-text">
      <h1>{{ title }}</h1>
      <ul class="room-meta">
        <li>{{ surface }}</li>
        <li>{{ capacite }}</li>
        {% if tarif %}<li class="price">{{ tarif }}</li>{% endif %}
      </ul>
    </div>
  </div>
  {% if photos and photos.length %}
  <section class="room-gallery">
    <h2>Photos de la chambre</h2>
    <div class="gallery-grid">
      {% for p in photos %}
      <img src="{{ p }}" alt="{{ title }}" loading="lazy" class="reveal">
      {% endfor %}
    </div>
  </section>
  {% endif %}
  <div class="room-body">
    <div class="room-content">
      {{ content | safe }}
      <div class="room-infos">
        <h2>Infos pratiques</h2>
        <ul>
          <li>Réservation à partir de 2 nuits minimum</li>
          <li>Wi-Fi gratuit</li>
          <li>Parking privatif</li>
          <li>Taxe de séjour réglée sur place</li>
          <li>Animaux non admis</li>
        </ul>
      </div>
    </div>
    <aside class="room-aside">
      <h2>Équipements</h2>
      <ul class="equip-list">
        {% for eq in equipements %}<li>{{ eq }}</li>{% endfor %}
      </ul>
      <div class="room-tarif">
        <h2>Tarif</h2>
        <p class="room-price">{{ site.tarif2 }} <span>/ 2 pers.</span> &nbsp;·&nbsp; {{ site.tarif1 }} <span>/ 1 pers.</span></p>
        <p class="room-tarif-note">{{ site.tarifNote }}</p>
        <p class="room-tarif-note"><strong>Paiement :</strong> {{ site.paiement }}</p>
      </div>
      <a href="/contact/?chambre={{ title | urlencode }}" class="btn btn-block">Demander cette chambre</a>
    </aside>
  </div>
</article>
